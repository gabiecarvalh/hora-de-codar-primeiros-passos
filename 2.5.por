programa
{
	
	funcao inicio() //2.5. Leia 6 valores, exiba todos e calcule a média aritmética.
	{
		inteiro a, b, c, d, e1, f
        real media

        escreva("Digite o primeiro valor: ")
        leia(a)

        escreva("Digite o segundo valor: ")
        leia(b)

        escreva("Digite o terceiro valor: ")
        leia(c)

        escreva("Digite o quarto valor: ")
        leia(d)

        escreva("Digite o quinto valor: ")
        leia(e1)

        escreva("Digite o sexto valor: ")
        leia(f)

        media = (a + b + c + d + e1 + f) / 6.0

        escreva("\nValores informados:\n")
        escreva(a, " ")
        escreva(b, " ")
        escreva(c, " ")
        escreva(d, " ")
        escreva(e1, " ")
        escreva(f)

        escreva("\nMédia: ", media)
	}
}
