programa
{
	
	funcao inicio() //2.2. Leia um valor e diga se ele é positivo, negativo ou zero.
	{
     inteiro n1

     escreva("Informe um número: ")
     leia(n1)

     se(n1 > 0)
     escreva("O número é positivo!")

     senao se(0 > n1)
     escreva("O número é negativo...")

     senao
     escreva("O número é zero!") 
	}
}

