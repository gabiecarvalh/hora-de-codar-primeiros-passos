programa
{
	
	funcao inicio() //3.1. Crie uma bomba-relógio com contagem regressiva de 30 até 0 e, ao final, escreva EXPLOSÃO.
	{
		inteiro contador

        para (contador = 30; contador >= 0; contador--)
        {
            escreva(contador, "\n")
        }

        escreva("EXPLOSÃO")
	}
}
