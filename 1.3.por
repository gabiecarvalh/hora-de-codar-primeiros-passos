programa
{
	
	funcao inicio() //1.3. Peça ao usuário nome e idade e exiba: Olá, [NomeDoUsuario], sua idade é [idade].
	{
		cadeia nome
		inteiro idade

		escreva("Informe seu nome: ") 
		leia(nome)

		escreva("Informe sua idade: ")
		leia(idade)

		escreva("Olá " + nome + ", sua idade é " + idade)
	}
}
