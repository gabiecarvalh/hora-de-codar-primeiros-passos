programa
{
	
	funcao inicio() //3.8. Imprima os 10 primeiros números inteiros maiores que 100.
	{
		inteiro numero

        para (numero = 101; numero <= 110; numero++)
        {
            escreva(numero, "\n")
        }
	}
}
