programa
{
	
	funcao inicio() //1.2. Peça ao usuário que informe o nome e exiba a mensagem: Olá, [NomeDoUsuario].
	{
		cadeia nome_usuario
		
		escreva("Informe o seu nome: ")
		leia(nome_usuario)
		
		escreva("Olá, ", nome_usuario)
	}
}
